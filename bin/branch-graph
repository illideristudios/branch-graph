#!/usr/bin/env python3
"""branch-graph: draw a branch's diff as a before/after module diagram.

Composition root: parse arguments, wire the git source, the language registry and the renderer, call the use case,
write page.html + page.mmd (or page-1.mmd… with --max-nodes), print one summary line then one line per new import edge.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from branch_graph import coverage_report, languages, providers, render  # noqa: E402
from branch_graph.domain import exclude, name, parse_rules, verdict  # noqa: E402
from branch_graph.git_source import GitSource  # noqa: E402
from branch_graph.use_case import branch_graph, measure  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="branch-graph", description=__doc__.splitlines()[0])
    p.add_argument("--repo", default=".")
    p.add_argument("--base", help="default: git merge-base origin/main HEAD")
    p.add_argument("--head", default="HEAD")
    p.add_argument("--root", required=True, help="import root inside the repo, e.g. agent or scripts")
    p.add_argument("--depth", type=int, default=2, help="module path segments per node")
    p.add_argument("--rules", type=Path, help="markdown file holding an ```import-rules block")
    p.add_argument("--notes", type=Path, help='JSON {"A -> B": "why"} for the new edges')
    p.add_argument("--colors", type=Path, help='JSON {"light": {"add": "#1f8a4c", ...}, "dark": {...}} over the default palette')
    p.add_argument("--exclude", action="append", default=[], metavar="GLOB", help="drop modules whose name matches, e.g. 'tests.*'; repeatable")
    p.add_argument("--max-nodes", type=int, metavar="N", help="split the drawing into views of at most N modules, page-1.mmd…")
    p.add_argument("--coverage", action="append", default=[], type=Path, metavar="REPORT",
                   help="Cobertura, Clover or LCOV report of the head revision; repeatable")
    p.add_argument("--dup-scope", choices=("changed", "modules", "root"), default="modules",
                   help="where copies of changed code are looked for (default: the modules the branch touched)")
    p.add_argument("--out", type=Path, required=True, help="page.html; page.mmd is written beside it")
    p.add_argument("--json", type=Path, help="machine-readable summary: nodes, new and removed edges with verdicts, drift count")
    p.add_argument("--fail-on-drift", action="store_true", help="exit 1 when a new import has the verdict drift; the page and output are still written")
    args = p.parse_args(argv)

    try:
        colors = render.palette(json.loads(args.colors.read_text()) if args.colors else None)
    except (ValueError, OSError) as e:
        p.error(str(e))

    try:
        rules = parse_rules(args.rules.read_text()) if args.rules else None
    except OSError as e:
        p.error(str(e))
    if args.fail_on_drift and rules is None:
        p.error("--fail-on-drift needs --rules with an import-rules block: no import-rules block found, so no import can be drift")

    source = GitSource(args.repo)
    base = args.base or source.merge_base("origin/main", args.head)
    select = languages.selector(languages.load())
    bd = branch_graph(source, select, base, args.head, args.root, args.depth)
    excluded = None
    if args.exclude:
        bd, excluded = exclude(bd, args.exclude)

    coverage: dict[str, dict[int, int]] = {}
    for report in args.coverage:
        try:
            for path, hits in coverage_report.read(report, sorted(bd.head.files)).items():
                for line, n in hits.items():
                    coverage.setdefault(path, {})[line] = max(n, coverage.get(path, {}).get(line, 0))
        except (ValueError, OSError) as e:
            p.error(str(e))
    report = measure(source, select, providers.load(), base, args.head, args.root, bd, coverage or None,
                     [str(r) for r in args.coverage], args.dup_scope)
    badges = render.badges(report)

    notes = json.loads(args.notes.read_text()) if args.notes else {}
    verdicts = {e.key: verdict(e, rules) for e in bd.edges_added}

    title = f"{Path(source.repo).name} {source.short(args.head)} branch graph"
    subtitle = f"{source.short(base)} → {source.short(args.head)}  ·  root {args.root}  ·  depth {args.depth}"
    stem = args.out.with_suffix("")
    # A previous run's diagrams would be render-checked as this run's.
    views_before = [f for f in stem.parent.glob(f"{stem.name}-*.mmd") if f.stem.removeprefix(f"{stem.name}-").isdigit()]
    for stale in [args.out.with_suffix(".mmd"), *views_before]:
        stale.unlink(missing_ok=True)
    if args.max_nodes is None:
        shown, rest = render.drawn(bd)
        diagrams = [("", render.mermaid(bd, verdicts, shown, rest, badges=badges), shown)]
        files = [args.out.with_suffix(".mmd")]
    else:
        try:
            views = render.views(bd, args.max_nodes)
        except ValueError as e:
            p.error(str(e))
        diagrams = [(v.title, render.view_mermaid(bd, verdicts, v, badges), v.shown) for v in views]
        shown = sorted({m for v in views for m in v.shown})
        rest = len(bd.base.nodes | bd.head.nodes) - len(shown)
        files = [Path(f"{stem}-{k}.mmd") for k in range(1, len(views) + 1)]
    files_of = {}
    for path, module in {**bd.base.files, **bd.head.files}.items():
        files_of.setdefault(module, []).append(path)
    changed_files = set(bd.numstat)
    hunks = {m: source.hunks(base, args.head, sorted(set(files_of.get(m, [])) & changed_files)) for m in shown}

    args.out.write_text(render.page(bd, title, subtitle, diagrams, verdicts, notes, hunks, shown, rest, colors, excluded, report))
    for path, (_, mmd, _) in zip(files, diagrams):
        path.write_text(mmd)

    print(render.summary(bd, verdicts, excluded, None if args.max_nodes is None else len(diagrams)))
    for e in bd.edges_added:
        print(f"{e.key}  {e.file}:{e.line}  {verdicts[e.key]}")
    drift = render.drift_count(verdicts)
    if args.json:
        args.json.write_text(json.dumps({
            "base": source.rev(base),
            "head": source.rev(args.head),
            "nodes": {kind: sorted(name(m) for m in modules)
                      for kind, modules in (("added", bd.added), ("removed", bd.removed), ("changed", bd.changed))},
            "edges": {kind: [{"src": name(e.src), "dst": name(e.dst), "file": e.file, "line": e.line,
                              **({"verdict": verdicts[e.key]} if kind == "added" else {})} for e in edges]
                      for kind, edges in (("added", bd.edges_added), ("removed", bd.edges_removed))},
            "drift": drift,
            "excluded": excluded,
            "views": None if args.max_nodes is None else len(diagrams),
        }))
    return 1 if args.fail_on_drift and drift else 0


if __name__ == "__main__":
    sys.exit(main())
